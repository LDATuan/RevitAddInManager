<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Surfaces  -->
    <SolidColorBrush x:Key="WindowBackground" Color="#14151C" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2C2E3A" />
    <SolidColorBrush x:Key="UserControlBackground" Color="#1C1E27" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1E27" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#21232E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2C38" />
    <SolidColorBrush x:Key="DividerBrush" Color="#282A35" />
    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#14151C" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#2C2F3D" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EAF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9396AB" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#565A6E" />
    <SolidColorBrush x:Key="TreeViewForeground" Color="#E9EAF2" />

    <!--  Controls  -->
    <SolidColorBrush x:Key="ControlFillBrush" Color="#252834" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#2D303E" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#343848" />
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#1F212B" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#343747" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#4A4E62" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#41455A" />

    <!--  Accent (indigo)  -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7173F5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8587F7" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5F61E8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#272A4D" />
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#30345C" />
    <SolidColorBrush x:Key="AccentSoftForegroundBrush" Color="#B4B6FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5B5CF0" />
        <GradientStop Offset="1" Color="#8B5CF6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6E70F7" />
        <GradientStop Offset="1" Color="#9D74F8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionBrush" Color="#292C52" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#262835" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#F2F3FA" />

    <!--  Status  -->
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2228" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5C46B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3222" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="AssemblyIconBackground" Color="#272A4D" />
    <SolidColorBrush x:Key="AssemblyIconForeground" Color="#A5A7FF" />
    <SolidColorBrush x:Key="CommandIconForeground" Color="#70748A" />

    <!--  ScrollBar  -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3D4052" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#565A70" />

    <!--  Log  -->
    <SolidColorBrush x:Key="LogDefaultBrush" Color="#E9EAF2" />

    <Color x:Key="ShadowColor">#000000</Color>
    <system:Double xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.35</system:Double>
</ResourceDictionary>
