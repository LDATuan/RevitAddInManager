<Window
    x:Class="RevitAddinManager.View.AssemblyLoader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Resolve Assembly"
    Width="460"
    Style="{DynamicResource ModernWindow}"
    Closing="AssemblyLoader_OnClosing"
    Icon="../Resources/dev.ico"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitAddinManager;component/Themes/Styles/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel
        Margin="16"
        TextElement.FontFamily="{StaticResource UiFont}"
        TextElement.FontSize="13"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <TextBlock
            FontSize="14"
            FontWeight="SemiBold"
            Text="Assembly could not be resolved" />
        <TextBlock
            Margin="0,4,0,0"
            Foreground="{DynamicResource TextSecondaryBrush}"
            Text="The following assembly can't be resolved automatically. Browse to its location to continue."
            TextWrapping="Wrap" />
        <ContentControl
            Margin="0,12,0,0"
            Padding="10,8"
            Style="{StaticResource Card}">
            <Label
                x:Name="tbxAssembly"
                Padding="0"
                Content="Assembly Name"
                FontFamily="{DynamicResource CodeFont}" />
        </ContentControl>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TbxAssemPath" Tag="Assembly path..." />
            <Button
                Grid.Column="1"
                Margin="6,0,0,0"
                Click="ButtonBase_OnClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                    <TextBlock Margin="6,0,0,0" Text="Browse..." />
                </StackPanel>
            </Button>
        </Grid>
        <StackPanel
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                MinWidth="88"
                Click="OKButtonClick"
                Content="OK"
                IsDefault="True"
                Style="{StaticResource AccentButton}" />
            <Button
                MinWidth="88"
                Margin="8,0,0,0"
                Click="Close_OnClick"
                Content="Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
