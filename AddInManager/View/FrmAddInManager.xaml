<Window
    x:Class="RevitAddinManager.View.FrmAddInManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="clr-namespace:RevitAddinManager.View.Control"
    xmlns:controls="clr-namespace:RevitAddinManager.Themes.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:RevitAddinManager.Model"
    xmlns:viewModel="clr-namespace:RevitAddinManager.ViewModel"
    Title="Revit Add In Manager"
    Width="{model:SettingBinding AppWidth}"
    Height="{model:SettingBinding AppHeight}"
    MinWidth="420"
    MinHeight="460"
    d:DataContext="{d:DesignInstance viewModel:AddInManagerViewModel}"
    d:DesignHeight="640"
    d:DesignWidth="480"
    Closed="OnCloseApp"
    FocusManager.FocusedElement="{Binding ElementName=tbxSearch}"
    Icon="../Resources/dev.ico"
    Left="{model:SettingBinding AppLeft}"
    PreviewKeyDown="CloseFormEvent"
    SizeChanged="FrmSizeChanged"
    controls:ModernWindow.TitleBarContent="{DynamicResource TitleBarButtons}"
    Style="{DynamicResource ModernWindow}"
    Top="{model:SettingBinding AppTop}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <!--  Light palette + styles; ThemManager overlays the dark palette at runtime.  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitAddinManager;component/Themes/Styles/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Tree row. Assemblies: badge + file name. Commands: class name only (the namespace is
                implied by the assembly row; the full name is in the tooltip and still searchable).
            -->
            <HierarchicalDataTemplate x:Key="AddinItemTemplate" ItemsSource="{Binding Children, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Name, Mode=OneTime}">
                    <CheckBox
                        VerticalAlignment="Center"
                        Focusable="False"
                        IsChecked="{Binding IsChecked}" />
                    <Border
                        x:Name="Badge"
                        Width="22"
                        Height="22"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AssemblyIconBackground}"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource AssemblyIconForeground}"
                            Style="{StaticResource Icon}"
                            Text="&#xE7B8;" />
                    </Border>
                    <TextBlock
                        x:Name="ItemName"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding Name, Mode=OneTime}" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Children.Count}" Value="0">
                        <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ItemName" Property="Margin" Value="10,0,0,0" />
                        <Setter TargetName="ItemName" Property="FontWeight" Value="Normal" />
                        <Setter TargetName="ItemName" Property="Text" Value="{Binding Name, Mode=OneTime, Converter={StaticResource ShortName}}" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <!--  Title bar buttons (rendered by the ModernWindow template)  -->
            <StackPanel x:Key="TitleBarButtons" Orientation="Horizontal">
                <Button
                    Width="32"
                    Height="32"
                    Command="{Binding ChangeThemCommand}"
                    Content="&#xE706;"
                    Style="{StaticResource IconButton}"
                    ToolTip="Toggle light / dark theme (Alt+T)" />
                <Button
                    Width="32"
                    Height="32"
                    Command="{Binding HelpCommand}"
                    Content="&#xE897;"
                    Style="{StaticResource IconButton}"
                    ToolTip="Help (F1)" />
            </StackPanel>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Command="{Binding RemoveCommand}" Gesture="Del" />
        <KeyBinding Command="{Binding ReloadCommand}" Gesture="F5" />
        <KeyBinding Command="{Binding HelpCommand}" Gesture="F1" />
        <KeyBinding Command="{Binding ChangeThemCommand}" Gesture="Alt+T" />
    </Window.InputBindings>

    <Grid Margin="14,4,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar: find, load, remove; everything else lives in the overflow menu  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Menu
                Margin="2,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right">
                <MenuItem
                    Width="38"
                    Height="38"
                    Padding="0"
                    ToolTip="More: save, version scope, cache">
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="15"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Style="{StaticResource Icon}"
                            Text="&#xE712;" />
                    </MenuItem.Header>
                    <MenuItem Command="{Binding SaveCommand}" Header="Save to Add-ins folder">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding SaveCommandFolder}" Header="Save as...">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE792;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding ExploreCommand}" Header="Open saved folder">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Header="Only this Revit version"
                        IsCheckable="True"
                        IsChecked="{Binding IsCurrentVersion, Mode=TwoWay}"
                        ToolTip="Off: commands and applications are available for all Revit versions" />
                    <MenuItem
                        Header="Separate list per version"
                        IsCheckable="True"
                        IsChecked="{Binding IsSeparateVersion, Mode=TwoWay}"
                        ToolTip="Keep separate loaded add-in lists for each Revit version" />
                    <Separator />
                    <MenuItem
                        Command="{Binding ReloadCommand}"
                        Header="Reload"
                        InputGestureText="F5">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Command="{Binding ClearCommand}"
                        Header="Clear cache"
                        ToolTip="Remove cached copies in the temp folder (requires Revit to be closed)">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA99;" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>
            <Button
                Margin="2,0,0,0"
                Command="{Binding RemoveCommand}"
                Content="&#xE74D;"
                DockPanel.Dock="Right"
                Style="{StaticResource IconButton}"
                ToolTip="Remove the selected command or application (Del)" />
            <Button
                MinHeight="38"
                Margin="8,0,0,0"
                Command="{Binding LoadCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource TonalButton}"
                ToolTip="Load a DLL containing commands or applications">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                    <TextBlock Margin="8,0,0,0" Text="Load" />
                </StackPanel>
            </Button>
            <TextBox
                x:Name="tbxSearch"
                PreviewKeyDown="HandleTextboxKeyPress"
                Style="{StaticResource SearchTextBox}"
                Tag="Search commands and apps..."
                Text="{Binding SearchText, Mode=TwoWay, Delay=200, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!--  Content  -->
        <ContentControl Grid.Row="1" Style="{StaticResource Card}">
            <TabControl x:Name="TabControl" SelectedIndex="{Binding SelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <TabItem
                    x:Name="TabCommand"
                    Header="Commands"
                    IsSelected="{Binding IsTabCmdSelected}"
                    PreviewKeyDown="HandleTreeViewCommandKeyPress"
                    ToolTip="External commands loaded from assemblies">
                    <control:ExtendedTreeView
                        x:Name="TreeViewCommand"
                        controls:EnableDragHelper.EnableDrag="True"
                        FontSize="13"
                        ItemTemplate="{StaticResource AddinItemTemplate}"
                        ItemsSource="{Binding CommandItems, Mode=TwoWay}"
                        PreviewMouseWheel="TreeViewCommand_OnPreviewMouseWheel"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem_="{Binding SelectedCommandItem, Mode=TwoWay}"
                        Style="{DynamicResource {x:Type TreeView}}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ExecuteAddinCommand}" Header="Run">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding ReloadCommand}"
                                    Header="Reload"
                                    InputGestureText="F5">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding LoadCommand}" Header="Load...">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding RemoveCommand}"
                                    Header="Remove"
                                    InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding OpenLcAssemblyCommand}" Header="Open Assembly Location">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding OpenRefsAssemblyCommand}" Header="Assembly Info...">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource TreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                                <Setter Property="control:MouseDoubleClick.CommandParameter" Value="{Binding}" />
                                <Setter Property="control:MouseDoubleClick.Command" Value="{Binding Path=DataContext.ExecuteAddinCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeView}}}" />
                                <Setter Property="control:ExtendedTreeView.ContextMenuOpened" Value="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeView}}}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </control:ExtendedTreeView>
                </TabItem>
                <TabItem
                    x:Name="TabApp"
                    controls:EnableDragHelper.EnableDrag="True"
                    Header="Apps"
                    IsSelected="{Binding IsTabAppSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    PreviewKeyDown="HandleTreeViewAppKeyPress"
                    ToolTip="External applications loaded from assemblies">
                    <control:ExtendedTreeView
                        x:Name="TreeViewApp"
                        FontSize="13"
                        ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                        ItemTemplate="{StaticResource AddinItemTemplate}"
                        ItemsSource="{Binding ApplicationItems, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItem_="{Binding SelectedAppItem, Mode=TwoWay}"
                        Style="{DynamicResource {x:Type TreeView}}">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ExecuteAddinCommand}" Header="Run">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding LoadCommand}" Header="Load...">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Command="{Binding RemoveCommand}"
                                    Header="Remove"
                                    InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Command="{Binding OpenLcAssemblyApp}" Header="Open Assembly Location">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </control:ExtendedTreeView>
                </TabItem>
                <TabItem
                    x:Name="tabStartUp"
                    Header="Startup"
                    IsSelected="{Binding IsTabStartSelected}"
                    ToolTip="Add-ins registered to load when Revit starts">
                    <DataGrid
                        x:Name="DataGridStartup"
                        Margin="0,4,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        ClipboardCopyMode="IncludeHeader"
                        ColumnWidth="*"
                        IsReadOnly="False"
                        ItemsSource="{Binding AddInStartUps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectionMode="Extended"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding OpenLocalAddinCommand}" Header="Open Add-in Location">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xED25;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding EditAddinCommand}" Header="Edit .addin File">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="104" Header="STATE">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="model:RevitAddin">
                                        <Button
                                            MinHeight="26"
                                            Padding="10,2"
                                            HorizontalAlignment="Left"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.VisibleToggle}"
                                            Content="{Binding State}"
                                            FontSize="11"
                                            IsEnabled="{Binding IsReadOnly}"
                                            Style="{StaticResource TonalButton}"
                                            ToolTip="Toggle to enable / disable this add-in" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="0.6*"
                                Binding="{Binding NameNotEx}"
                                Header="NAME">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding FilePath}"
                                Header="FULL PATH">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding FilePath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem
                    Header="Trace"
                    IsSelected="{Binding IsTabLogSelected}"
                    ToolTip="Listen to Trace, Debug and Revit events">
                    <control:LogControl x:Name="LogControl" />
                </TabItem>
            </TabControl>
        </ContentControl>

        <!--  Primary action  -->
        <Button
            x:Name="RunButton"
            Grid.Row="2"
            Margin="0,12,0,0"
            Command="{Binding ExecuteAddinCommand}"
            IsEnabled="{Binding IsCanRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource HeroButton}"
            ToolTip="Run the selected add-in (Enter, or double-click it)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Style="{StaticResource OnAccentChip}">
                    <TextBlock
                        Margin="2,0,0,0"
                        FontSize="14"
                        Style="{StaticResource Icon}"
                        Text="&#xE768;" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="12,0"
                    VerticalAlignment="Center">
                    <TextBlock Text="Run" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        FontWeight="Normal"
                        Opacity="0.85"
                        TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedCommandItem.Name, Converter={StaticResource ShortName}}" />
                                <Style.Triggers>
                                    <!--  Nothing runnable selected: explain instead of showing a stale name.  -->
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=RunButton}" Value="False">
                                        <Setter Property="Text" Value="Select a command to run" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border
                    Grid.Column="2"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Style="{StaticResource OnAccentChip}"
                    Visibility="{Binding IsEnabled, ElementName=RunButton, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="Enter" />
                </Border>
            </Grid>
        </Button>

        <!--  Rarely used: collapsed by default, with the current value as a preview  -->
        <Expander Grid.Row="3" Margin="0,8,0,0">
            <Expander.Header>
                <DockPanel>
                    <TextBlock Text="Vendor description" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource TextDisabledBrush}"
                        Text="{Binding VendorDescription}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Expander.Header>
            <TextBox
                x:Name="TbxDescription"
                Height="60"
                VerticalContentAlignment="Top"
                LostKeyboardFocus="TbxDescription_OnLostKeyboardFocus"
                Tag="Default: Autodesk, www.autodesk.com"
                Text="{Binding VendorDescription, Mode=Default, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Expander>
    </Grid>
</Window>
