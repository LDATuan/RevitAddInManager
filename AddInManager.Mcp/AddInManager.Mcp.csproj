    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RevitAddinManager.Mcp</AssemblyName>
    <RootNamespace>RevitAddinManager.Mcp</RootNamespace>
    <Description>MCP server that lets AI agents drive Revit Add-in Manager</Description>
